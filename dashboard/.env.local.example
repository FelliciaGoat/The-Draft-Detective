# Copy this file to `.env.local`:   cp .env.local.example .env.local
# Restart `npm run dev` after changing it.

# Where the FastAPI backend runs. Used by the browser (REST + WebSocket).
NEXT_PUBLIC_API_URL=http://localhost:8000

# SERVER-ONLY secret (no NEXT_PUBLIC_ prefix, so it never reaches the browser).
# Must match DEVICE_API_KEY in the backend's .env. Used only by the "Run demo" button,
# which calls the backend from a Next.js server route.
   DEVICE_API_KEY=hackathon-demo-key-2026
