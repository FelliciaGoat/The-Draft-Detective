# Copy this file to `.env` and edit it:   cp .env.example .env
# Values below are safe development defaults. NEVER commit your real `.env`.

# ---- Database -------------------------------------------------------------
# SQLite (development, zero setup):
DATABASE_URL=sqlite:///./occupancy.db
# PostgreSQL (production / docker-compose):
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/occupancy

# ---- MQTT -----------------------------------------------------------------
# Set MQTT_ENABLED=true once a broker (e.g. Mosquitto) is running.
MQTT_ENABLED=false
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ---- Security -------------------------------------------------------------
# ESP32 devices send this in the `X-API-Key` header. Choose your own long random value,
# e.g. generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
   DEVICE_API_KEY=hackathon-demo-key-2026

# ---- CORS (comma-separated list of allowed frontend origins) ---------------
CORS_ORIGINS=http://localhost:3000

# ---- Convenience ----------------------------------------------------------
# Creates "Room A-101" (id 1) with sensors on first start if the database has no rooms.
SEED_DEMO_DATA=true
LOG_LEVEL=INFO

# ---- Optional tuning (defaults are in app/core/config.py) ------------------
# OCC_ON_THRESHOLD=0.30
# OCC_OFF_THRESHOLD=0.15
# OCC_VACANT_PERSISTENCE_SECONDS=300
# THERMAL_PERSISTENCE_SECONDS=300
# DEFAULT_HVAC_POWER_KW=1.5
# DASHBOARD_UTC_OFFSET_MINUTES=330     # e.g. 330 = India (UTC+05:30); affects "today"/"this month"
